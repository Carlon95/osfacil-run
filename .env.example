# Banco de dados. Para produção, troque por uma URL Postgres (ex: Supabase)
# e mude o "provider" em prisma/schema.prisma de "sqlite" para "postgresql".
DATABASE_URL="file:./dev.db"

# Chave secreta usada para assinar o cookie de sessão (JWT).
# Gere uma nova em produção, por exemplo com: openssl rand -base64 32
AUTH_SECRET="troque-esta-chave-antes-de-ir-para-producao"
