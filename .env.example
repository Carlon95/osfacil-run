# Banco de dados (libSQL). Local: "file:./dev.db". Em produção, use a URL
# de um banco no Turso (https://turso.tech), algo como
# "libsql://seu-banco.turso.io" — veja DEPLOY.md.
DATABASE_URL="file:./dev.db"
# Token de autenticação do Turso. Só é necessário em produção (bancos
# locais com "file:" não usam token).
DATABASE_AUTH_TOKEN=""

# Chave secreta usada para assinar o cookie de sessão (JWT).
# Gere uma nova em produção, por exemplo com: openssl rand -base64 32
AUTH_SECRET="troque-esta-chave-antes-de-ir-para-producao"

# URL pública do app (usada nos links de redirecionamento do Stripe).
# Em produção, coloque a URL real (ex: https://os-facil-seuuser.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — veja STRIPE.md para o passo a passo de como conseguir esses valores
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Focus NFe (emissão de nota fiscal) — veja FOCUSNFE.md
FOCUS_NFE_TOKEN=""
FOCUS_NFE_ENV="homologacao"
